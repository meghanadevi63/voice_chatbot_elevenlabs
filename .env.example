GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Answer models selectable in Voice settings ("model_id:Label" sets a display name)
LLM_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
ROUTER_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MILVUS_DB_PATH=./data/milvus.db
COLLECTION_NAME=docs_rag
DOCS_DIR=./docs

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# ElevenLabs (voice). Key needs: Speech to Text, Text to Speech, Voices (read),
# ElevenAgents (write), Models, User.
ELEVENLABS_API_KEY=
STT_MODEL=scribe_v2
MAX_AUDIO_MB=10
# Allow-listed TTS models (first is the default)
TTS_MODELS=eleven_v4_turbo,eleven_v3_conversational
DEFAULT_VOICE_ID=XrExE9yKIg1WjnnlVkGX
MAX_TTS_CHARS=800
# Dev-only audio cache; leave empty in production
TTS_CACHE_DIR=./data/tts_cache

# Comma-separated origins allowed to call the API directly from a browser.
# Add https://<your-lan-ip>:5174 if other machines call the backend directly.
CORS_ORIGINS=https://localhost:5174,https://127.0.0.1:5174
